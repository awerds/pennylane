# Copy this file to `.env` (gitignored) and paste your free RapidAPI key below.
# Recommended free-tier RapidAPI Zillow APIs ($0/mo Basic plan):
#   1) https://rapidapi.com/apimaker/api/zillow-com1             -> ZILLOW_API_HOST=zillow-com1.p.rapidapi.com
#   2) https://rapidapi.com/s.mahmoud97/api/zillow56            -> ZILLOW_API_HOST=zillow56.p.rapidapi.com
#   3) https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-zillow-data -> ZILLOW_API_HOST=real-time-zillow-data.p.rapidapi.com

ZILLOW_API_KEY=your_rapidapi_key_here
ZILLOW_API_HOST=zillow-com1.p.rapidapi.com

# How many US markets to query per sync run (each call returns up to ~40 real homes!).
# Tip: Use 10-20 for your first seed, then 1-2/day to stay 100% inside the free tier.
ZILLOW_BATCH_SIZE=8

# Optional: Pin specific cities/states (semicolon-separated). Leave blank to rotate through all 50 US states!
# PENNYLANE_MARKETS=Hudson, NY;Marfa, TX;Palm Springs, CA;Savannah, GA;Asheville, NC

# Optional: Free lead capture webhook (Formspree / Web3Forms / Zapier / HubSpot)
# VITE_LEAD_WEBHOOK_URL=https://formspree.io/f/your-form-id
